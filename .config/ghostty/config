background-opacity = 0.90
background-blur = 5
# Disable ligatures
font-feature = -calt

keybind = global:cmd+f12=toggle_quick_terminal
# unbind toggle_fullscreen
keybind = cmd+enter=unbind 
quit-after-last-window-closed = true

# Navigation
## Lines

keybind = cmd+k=scroll_page_lines:-1
keybind = cmd+j=scroll_page_lines:1
keybind = cmd+shift+k=scroll_page_lines:-10
keybind = cmd+shift+j=scroll_page_lines:10

## Splits

keybind = cmd+option+h=goto_split:left
keybind = cmd+option+j=goto_split:down
keybind = cmd+option+k=goto_split:up
keybind = cmd+option+l=goto_split:right

